{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "AXISLY_BUILD_TESTS": "ON",
        "AXISLY_BUILD_EXAMPLES": "ON",
        "AXISLY_BUILD_REFERENCE_TESTS": "OFF",
        "AXISLY_BUILD_PLAYGROUND": "OFF",
        "AXISLY_FETCH_SDL3": "OFF",
        "AXISLY_BUILD_BENCHMARKS": "OFF",
        "AXISLY_BUILD_COMPARISON_BENCHMARKS": "OFF",
        "AXISLY_BUILD_GEEYOOU_SHOWCASE": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug with tests and API example",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release with tests and API example",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-clang",
      "displayName": "Windows Release with clang-cl and the MSVC runtime",
      "inherits": "release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-cl.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "reference-debug",
      "displayName": "Debug with optional Taffy differential tests",
      "inherits": "debug",
      "cacheVariables": {
        "AXISLY_BUILD_REFERENCE_TESTS": "ON"
      }
    },
    {
      "name": "reference-release",
      "displayName": "Release with optional Taffy differential tests",
      "inherits": "release",
      "cacheVariables": {
        "AXISLY_BUILD_REFERENCE_TESTS": "ON"
      }
    },
    {
      "name": "playground-debug",
      "displayName": "Debug with SDL3 visual playground (downloads pinned SDL3)",
      "inherits": "debug",
      "cacheVariables": {
        "AXISLY_BUILD_PLAYGROUND": "ON",
        "AXISLY_FETCH_SDL3": "ON"
      }
    },
    {
      "name": "playground-release",
      "displayName": "Release with SDL3 visual playground (downloads pinned SDL3)",
      "inherits": "release",
      "cacheVariables": {
        "AXISLY_BUILD_PLAYGROUND": "ON",
        "AXISLY_FETCH_SDL3": "ON"
      }
    },
    {
      "name": "benchmark-release",
      "displayName": "Release with layout timing and allocation benchmarks",
      "inherits": "release",
      "cacheVariables": {
        "AXISLY_BUILD_BENCHMARKS": "ON",
        "AXISLY_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "benchmark-debug",
      "displayName": "Debug benchmark correctness checks (not a timing baseline)",
      "inherits": "debug",
      "cacheVariables": {
        "AXISLY_BUILD_BENCHMARKS": "ON",
        "AXISLY_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "comparison-release",
      "displayName": "Release comparison with pinned Taffy and Yoga",
      "inherits": "benchmark-release",
      "cacheVariables": {
        "AXISLY_BUILD_COMPARISON_BENCHMARKS": "ON"
      }
    },
    {
      "name": "comparison-clang",
      "displayName": "Windows clang-cl comparison with pinned Taffy and Yoga",
      "inherits": "comparison-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-cl.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "geeyoou-release",
      "displayName": "GeeyoouUI Showcase / release",
      "inherits": "release",
      "cacheVariables": {
        "AXISLY_BUILD_GEEYOOU_SHOWCASE": "ON"
      }
    },
    {
      "name": "geeyoou-debug",
      "displayName": "GeeyoouUI Showcase / debug",
      "inherits": "debug",
      "cacheVariables": {
        "AXISLY_BUILD_GEEYOOU_SHOWCASE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release-clang",
      "configurePreset": "release-clang"
    },
    {
      "name": "comparison-clang",
      "configurePreset": "comparison-clang"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "reference-debug",
      "configurePreset": "reference-debug"
    },
    {
      "name": "reference-release",
      "configurePreset": "reference-release"
    },
    {
      "name": "playground-debug",
      "configurePreset": "playground-debug"
    },
    {
      "name": "playground-release",
      "configurePreset": "playground-release"
    },
    {
      "name": "benchmark-release",
      "configurePreset": "benchmark-release"
    },
    {
      "name": "benchmark-debug",
      "configurePreset": "benchmark-debug"
    },
    {
      "name": "comparison-release",
      "configurePreset": "comparison-release"
    },
    {
      "name": "geeyoou-release",
      "configurePreset": "geeyoou-release"
    },
    {
      "name": "geeyoou-debug",
      "configurePreset": "geeyoou-debug"
    }
  ],
  "testPresets": [
    {
      "name": "release-clang",
      "configurePreset": "release-clang",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "comparison-clang",
      "configurePreset": "comparison-clang",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "reference-debug",
      "configurePreset": "reference-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "reference-release",
      "configurePreset": "reference-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "playground-debug",
      "configurePreset": "playground-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "playground-release",
      "configurePreset": "playground-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "benchmark-release",
      "configurePreset": "benchmark-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "benchmark-debug",
      "configurePreset": "benchmark-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "comparison-release",
      "configurePreset": "comparison-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "geeyoou-release",
      "configurePreset": "geeyoou-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "geeyoou-debug",
      "configurePreset": "geeyoou-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
