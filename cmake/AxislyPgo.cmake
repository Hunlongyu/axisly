# Explicit Clang instrumentation/use workflow. Default builds stay portable
# and do not depend on a machine-specific profile or compiler runtime.
set(AXISLY_CLANG_PGO "OFF" CACHE STRING "Clang profile optimization: OFF, GENERATE, USE")
set_property(CACHE AXISLY_CLANG_PGO PROPERTY STRINGS OFF GENERATE USE)
set(AXISLY_PROFILE_PATH "" CACHE PATH "PGO output directory (GENERATE) or merged .profdata file (USE)")
if(AXISLY_CLANG_PGO STREQUAL "OFF")
    return()
endif()
if(NOT AXISLY_CLANG_PGO MATCHES "^(GENERATE|USE)$")
    message(FATAL_ERROR "AXISLY_CLANG_PGO must be OFF, GENERATE, or USE")
endif()
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    message(FATAL_ERROR "AXISLY_CLANG_PGO requires Clang; leave it OFF with other compilers")
endif()
if(AXISLY_ENABLE_SANITIZERS)
    message(FATAL_ERROR "Use separate PGO and sanitizer build directories")
endif()
if(NOT AXISLY_PROFILE_PATH)
    message(FATAL_ERROR "AXISLY_PROFILE_PATH is required for PGO")
endif()
get_filename_component(axisly_profile "${AXISLY_PROFILE_PATH}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
file(TO_CMAKE_PATH "${axisly_profile}" axisly_profile)
set(axisly_clang_prefix "")
if(MSVC)
    set(axisly_clang_prefix "/clang:")
endif()
if(AXISLY_CLANG_PGO STREQUAL "GENERATE")
    file(MAKE_DIRECTORY "${axisly_profile}")
    target_compile_options(axisly PRIVATE "${axisly_clang_prefix}-fprofile-generate=${axisly_profile}"
        "${axisly_clang_prefix}-fprofile-update=atomic")
    if(MSVC)
        execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -print-resource-dir
            OUTPUT_VARIABLE axisly_profile_runtime_root OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        # Clang emits the correct architecture-specific profile runtime name
        # in each object. CMake's direct linker invocation needs its directory.
        target_link_options(axisly INTERFACE "/LIBPATH:${axisly_profile_runtime_root}/lib/windows")
    else()
        target_link_options(axisly INTERFACE "-fprofile-generate=${axisly_profile}")
    endif()
else()
    if(NOT EXISTS "${axisly_profile}" OR IS_DIRECTORY "${axisly_profile}")
        message(FATAL_ERROR "PGO USE requires an existing merged .profdata file")
    endif()
    target_compile_options(axisly PRIVATE "${axisly_clang_prefix}-fprofile-use=${axisly_profile}"
        "${axisly_clang_prefix}-Werror=profile-instr-out-of-date")
    # Updating a profile in place must rebuild objects that consumed it.
    set_property(SOURCE ${axisly_profile} PROPERTY HEADER_FILE_ONLY TRUE)
    get_target_property(axisly_profile_sources axisly SOURCES)
    set_property(SOURCE ${axisly_profile_sources} APPEND PROPERTY OBJECT_DEPENDS "${axisly_profile}")
endif()
