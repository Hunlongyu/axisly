+//! CSSCMP1 tree benchmark. Parsing, creation and destruction are outside timers.
+use std::{env, fs, str::SplitWhitespace, time::Instant};
+use taffy::prelude::*;
+
+type Result<T> = std::result::Result<T, String>;
+struct Reader<'a>(SplitWhitespace<'a>);
+impl Reader<'_> {
+    fn token(&mut self) -> Result<&str> {
+        self.0.next().ok_or_else(|| "Truncated fixture".into())
+    }
+    fn number<T: std::str::FromStr>(&mut self) -> Result<T> {
+        self.token()?.parse().map_err(|_| "Invalid number".into())
+    }
+    fn tracks(&mut self, count: usize) -> Result<Vec<GridTemplateComponent<String>>> {
+        if count > 1000 {
+            return Err("Too many tracks".into());
+        }
+        (0..count)
+            .map(|_| {
+                let kind = self.token()?.to_owned();
+                let value: f32 = self.number()?;
+                if !value.is_finite() || value < 0.0 {
+                    return Err("Invalid track value".into());
+                }
+                match kind.as_str() {
+                    "F" => Ok(length(value)),
+                    "W" => Ok(minmax(length(0.0), fr(value))),
+                    "A" => Ok(auto()),
+                    _ => Err("Unknown track".into()),
+                }
+            })
+            .collect()
+    }
+}
+struct Node {
+    parent: i32,
+    style: Style,
+    measure: u8,
+    preferred: Size<f32>,
+}
+struct Fixture {
+    nodes: Vec<Node>,
+    sizes: Vec<Size<f32>>,
+    measured: Vec<usize>,
+}
+fn dimension(v: f32) -> Result<Dimension> {
+    match v {
+        -1.0 => Ok(auto()),
+        -2.0 => Ok(percent(1.0)),
+        v if v.is_finite() && v >= 0.0 => Ok(length(v)),
+        _ => Err("Invalid dimension".into()),
+    }
+}
+fn read(path: &str) -> Result<Fixture> {
+    let text = fs::read_to_string(path).map_err(|e| e.to_string())?;
+    let mut r = Reader(text.split_whitespace());
+    if r.token()? != "CSSCMP1" {
+        return Err("Invalid fixture magic".into());
+    }
+    let _name = r.token()?;
+    let count: usize = r.number()?;
+    let frames: usize = r.number()?;
+    if !(2..=100001).contains(&count) || !(2..=100).contains(&frames) {
+        return Err("Invalid fixture shape".into());
+    }
+    let mut nodes = Vec::with_capacity(count);
+    let mut measured = Vec::new();
+    let mut ancestors = Vec::new();
+    let mut has_children = vec![false; count];
+    for i in 0..count {
+        let parent: i32 = r.number()?;
+        if (i == 0 && parent != -1) || (i > 0 && (parent < 0 || parent as usize >= i)) {
+            return Err("Invalid parent".into());
+        }
+        if i > 0 {
+            while ancestors.last().is_some_and(|p| *p != parent) {
+                ancestors.pop();
+            }
+            if ancestors.is_empty() {
+                return Err("Fixture must use depth-first node order".into());
+            }
+            has_children[parent as usize] = true;
+        }
+        ancestors.push(i as i32);
+        let display = match r.token()? {
+            "F" => Display::Flex,
+            "G" => Display::Grid,
+            "B" => Display::Block,
+            _ => return Err("Unknown display".into()),
+        };
+        let direction = match r.token()? {
+            "R" => FlexDirection::Row,
+            "C" => FlexDirection::Column,
+            _ => return Err("Unknown flex direction".into()),
+        };
+        let wrap = match r.number::<u8>()? {
+            0 => FlexWrap::NoWrap,
+            1 => FlexWrap::Wrap,
+            _ => return Err("Unknown wrap".into()),
+        };
+        let width = dimension(r.number()?)?;
+        let height = dimension(r.number()?)?;
+        let basis = dimension(r.number()?)?;
+        let grow: f32 = r.number()?;
+        let shrink: f32 = r.number()?;
+        let padding: f32 = r.number()?;
+        let margin: f32 = r.number()?;
+        let gap: f32 = r.number()?;
+        let column: i16 = r.number()?;
+        let column_span: u16 = r.number()?;
+        let row: i16 = r.number()?;
+        let row_span: u16 = r.number()?;
+        let measure: u8 = r.number()?;
+        let preferred = Size {
+            width: r.number()?,
+            height: r.number()?,
+        };
+        let cols: usize = r.number()?;
+        let rows: usize = r.number()?;
+        if column < 0
+            || column > 1000
+            || row < 0
+            || row > 1000
+            || column_span == 0
+            || column_span > 1000
+            || row_span == 0
+            || row_span > 1000
+            || measure > 2
+            || [
+                grow,
+                shrink,
+                padding,
+                margin,
+                gap,
+                preferred.width,
+                preferred.height,
+            ]
+            .iter()
+            .any(|v| !v.is_finite() || *v < 0.0)
+        {
+            return Err("Invalid CSS node".into());
+        }
+        let style = Style {
+            display,
+            box_sizing: BoxSizing::BorderBox,
+            size: Size { width, height },
+            min_size: length(0.0),
+            flex_direction: direction,
+            flex_wrap: wrap,
+            flex_basis: basis,
+            flex_grow: grow,
+            flex_shrink: shrink,
+            padding: length(padding),
+            margin: length(margin),
+            gap: length(gap),
+            align_items: Some(AlignItems::STRETCH),
+            justify_items: Some(AlignItems::STRETCH),
+            align_content: Some(AlignContent::START),
+            justify_content: Some(AlignContent::START),
+            grid_column: Line {
+                start: if column == 0 { auto() } else { line(column) },
+                end: span(column_span),
+            },
+            grid_row: Line {
+                start: if row == 0 { auto() } else { line(row) },
+                end: span(row_span),
+            },
+            grid_template_columns: r.tracks(cols)?,
+            grid_template_rows: r.tracks(rows)?,
+            ..Default::default()
+        };
+        if measure > 0 {
+            measured.push(i);
+        }
+        nodes.push(Node {
+            parent,
+            style,
+            measure,
+            preferred,
+        });
+    }
+    if measured.iter().any(|i| has_children[*i]) {
+        return Err("Measured node must be a leaf".into());
+    }
+    let mut sizes = Vec::with_capacity(frames);
+    for _ in 0..frames {
+        let size: Size<f32> = Size {
+            width: r.number()?,
+            height: r.number()?,
+        };
+        if !size.width.is_finite()
+            || size.width < 0.0
+            || !size.height.is_finite()
+            || (size.height < 0.0 && size.height != -1.0)
+        {
+            return Err("Invalid viewport".into());
+        }
+        sizes.push(size);
+    }
+    if r.0.next().is_some() {
+        return Err("Trailing fixture data".into());
+    }
+    Ok(Fixture {
+        nodes,
+        sizes,
+        measured,
+    })
+}
+#[derive(Clone, Copy)]
+struct Metrics {
+    kind: u8,
+    preferred: Size<f32>,
+    revision: usize,
+}
+fn measure(m: Metrics, known: Size<Option<f32>>, available: Size<AvailableSpace>) -> Size<f32> {
+    let preferred = m.preferred.width + (m.revision % 7) as f32 * 8.0;
+    let minimum = if m.kind == 2 {
+        preferred.min(40.0)
+    } else {
+        preferred
+    };
+    let width = known.width.unwrap_or(match available.width {
+        AvailableSpace::MinContent => minimum,
+        AvailableSpace::MaxContent => preferred,
+        AvailableSpace::Definite(limit) => preferred.min(limit),
+    });
+    let lines = if m.kind == 2 {
+        (preferred / width.max(1.0)).ceil().max(1.0)
+    } else {
+        1.0
+    };
+    Size {
+        width,
+        height: known.height.unwrap_or(lines * m.preferred.height),
+    }
+}
+struct Engine<'a> {
+    fixture: &'a Fixture,
+    tree: TaffyTree<Metrics>,
+    nodes: Vec<NodeId>,
+    measurements: usize,
+}
+impl<'a> Engine<'a> {
+    fn new(f: &'a Fixture) -> Self {
+        let mut tree = TaffyTree::with_capacity(f.nodes.len());
+        tree.disable_rounding();
+        let mut nodes = Vec::with_capacity(f.nodes.len());
+        for n in &f.nodes {
+            let node = if n.measure > 0 {
+                tree.new_leaf_with_context(
+                    n.style.clone(),
+                    Metrics {
+                        kind: n.measure,
+                        preferred: n.preferred,
+                        revision: 0,
+                    },
+                )
+            } else {
+                tree.new_leaf(n.style.clone())
+            }
+            .unwrap();
+            nodes.push(node);
+            if n.parent >= 0 {
+                tree.add_child(nodes[n.parent as usize], node).unwrap();
+            }
+        }
+        Self {
+            fixture: f,
+            tree,
+            nodes,
+            measurements: 0,
+        }
+    }
+    fn edit(&mut self, i: usize) {
+        self.tree
+            .get_node_context_mut(self.nodes[i])
+            .unwrap()
+            .revision += 1;
+        self.tree.mark_dirty(self.nodes[i]).unwrap();
+    }
+    fn calculate(&mut self, size: Size<f32>) {
+        self.measurements = 0;
+        let count = &mut self.measurements;
+        self.tree
+            .compute_layout_with_measure(
+                self.nodes[0],
+                Size {
+                    width: AvailableSpace::Definite(size.width),
+                    height: if size.height < 0.0 {
+                        AvailableSpace::MaxContent
+                    } else {
+                        AvailableSpace::Definite(size.height)
+                    },
+                },
+                |inputs, _, context, style| {
+                    taffy::compute_leaf_layout(
+                        inputs,
+                        style,
+                        |_, _| 0.0,
+                        |known, available| {
+                            if let Some(context) = context {
+                                *count += 1;
+                                measure(*context, known, available)
+                            } else {
+                                Size::ZERO
+                            }
+                        },
+                    )
+                },
+            )
+            .unwrap();
+    }
+    fn rect(&self, i: usize) -> [f32; 4] {
+        let r = self.tree.layout(self.nodes[i]).unwrap();
+        let mut x = r.location.x;
+        let mut y = r.location.y;
+        let mut parent = self.fixture.nodes[i].parent;
+        while parent >= 0 {
+            let p = self.tree.layout(self.nodes[parent as usize]).unwrap();
+            x += p.location.x;
+            y += p.location.y;
+            parent = self.fixture.nodes[parent as usize].parent;
+        }
+        [x, y, r.size.width, r.size.height]
+    }
+    fn consume(&self) -> f64 {
+        [0, self.nodes.len() / 2, self.nodes.len() - 1]
+            .into_iter()
+            .map(|i| {
+                let [x, y, w, h] = self.rect(i);
+                x as f64 + y as f64 * 0.5 + w as f64 * 0.25 + h as f64 * 0.125
+            })
+            .sum()
+    }
+    fn step(&mut self, mode: &str, frame: usize) {
+        if mode == "leaf_edit" {
+            self.edit(self.fixture.measured[frame * 17 % self.fixture.measured.len()]);
+        }
+        self.calculate(if mode == "same" || mode == "leaf_edit" {
+            *self.fixture.sizes.last().unwrap()
+        } else {
+            self.fixture.sizes[frame % self.fixture.sizes.len()]
+        });
+    }
+}
+fn positive(arg: &str) -> Result<usize> {
+    let n = arg.parse().map_err(|_| "Invalid count")?;
+    if !(1..=100000).contains(&n) {
+        return Err("Invalid count".into());
+    }
+    Ok(n)
+}
+fn run() -> Result<()> {
+    let args: Vec<_> = env::args().collect();
+    if args.len() != 6 || args[1] != "taffy" {
+        return Err(
+            "Usage: css taffy fixture [verify_]cold|resize|same|leaf_edit iterations samples"
+                .into(),
+        );
+    }
+    let f = read(&args[2])?;
+    let verify = args[3].starts_with("verify_");
+    let mode = args[3].strip_prefix("verify_").unwrap_or(&args[3]);
+    if !["cold", "resize", "same", "leaf_edit"].contains(&mode) {
+        return Err("Unknown mode".into());
+    }
+    if mode == "leaf_edit" && f.measured.is_empty() {
+        return Err("Edit requires measured leaves".into());
+    }
+    let iterations = positive(&args[4])?;
+    let samples = positive(&args[5])?;
+    if verify {
+        let mut engine = Engine::new(&f);
+        if mode != "cold" {
+            engine.calculate(*f.sizes.last().unwrap());
+        }
+        let mut frames = Vec::with_capacity(iterations);
+        for i in 0..iterations {
+            if mode == "cold" {
+                engine = Engine::new(&f);
+            }
+            engine.step(mode, i);
+            frames.push(
+                (0..f.nodes.len())
+                    .map(|j| engine.rect(j))
+                    .collect::<Vec<_>>(),
+            );
+        }
+        println!("{{\"frames\":{frames:?}}}");
+        return Ok(());
+    }
+    for size in &f.sizes {
+        let mut engine = Engine::new(&f);
+        engine.calculate(*size);
+    }
+    let mut times = Vec::new();
+    let mut checksums = Vec::new();
+    let mut counts = Vec::new();
+    for _ in 0..samples {
+        let mut engine = Engine::new(&f);
+        if mode != "cold" {
+            engine.calculate(*f.sizes.last().unwrap());
+        }
+        let mut elapsed = 0.0;
+        let mut checksum = 0.0;
+        let mut measurements = 0;
+        for i in 0..iterations {
+            if mode == "cold" {
+                engine = Engine::new(&f);
+            }
+            let start = Instant::now();
+            engine.step(mode, i);
+            let consumed = engine.consume();
+            elapsed += start.elapsed().as_secs_f64() * 1e6;
+            checksum += consumed;
+            measurements += engine.measurements;
+        }
+        times.push(elapsed / iterations as f64);
+        checksums.push(checksum);
+        counts.push(measurements as f64 / iterations as f64);
+    }
+    println!("{{\"build\":\"Release\",\"samples_us\":{times:?},\"checksums\":{checksums:?},\"measurements\":{counts:?}}}");
+    Ok(())
+}
+fn main() {
+    if let Err(e) = run() {
+        eprintln!("{e}");
+        std::process::exit(1);
+    }
+}
diff --git a/src/css/layout_cache.cpp b/src/css/layout_cache.cpp
new file mode 100644
index 0000000..3c8641c
--- /dev/null
+++ b/src/css/layout_cache.cpp
@@ -0,0 +1,184 @@
+#include "layout_cache.hpp"
+
+#include <algorithm>
+
+namespace axisly::css::detail {
+namespace {
+template<class Arena>
+std::pair<std::size_t, std::size_t> oldest(const Arena& arena, const CacheList& list) {
+    auto previous = no_cache_entry;
+    auto index = list.head;
+    while (arena[index].next != no_cache_entry) {
+        previous = index;
+        index = arena[index].next;
+    }
+    return {previous, index};
+}
+
+template<class Arena>
+void evict(Arena& arena, CacheList& list, std::size_t previous, std::size_t index) {
+    if (previous == no_cache_entry) list.head = no_cache_entry;
+    else arena[previous].next = no_cache_entry;
+    arena.erase(index);
+    --list.count;
+}
+} // namespace
+
+LayoutCacheKey LayoutCacheKey::from(const Constraints& c, std::size_t depth) noexcept {
+    const auto bit = [](bool value, unsigned shift) { return std::uint32_t(value) << shift; };
+    return {{c.known_width.value_or(0), c.known_height.value_or(0),
+             c.containing_width.value_or(0), c.containing_height.value_or(0),
+             c.available.width.value, c.available.height.value},
+        bit(c.known_width.has_value(), 0) | bit(c.known_height.has_value(), 1)
+        | bit(c.containing_width.has_value(), 2) | bit(c.containing_height.has_value(), 3)
+        | bit(c.known_width_is_final, 4) | bit(c.known_height_is_final, 5)
+        | bit(c.known_width_is_definite, 6) | bit(c.known_height_is_definite, 7)
+        | bit(c.ignore_preferred_width, 8) | bit(c.ignore_preferred_height, 9)
+        | bit(c.ignore_min_max_width, 10) | bit(c.ignore_min_max_height, 11)
+        | bit(c.content_based_width, 12) | bit(c.preserve_known_grid_size, 13)
+        | (static_cast<std::uint32_t>(c.sizing_mode) << 14)
+        | (static_cast<std::uint32_t>(c.detail) << 15)
+        | (static_cast<std::uint32_t>(c.available.width.kind) << 17)
+        | (static_cast<std::uint32_t>(c.available.height.kind) << 20), depth};
+}
+
+void LayoutCache::invalidate(NodeCache& node) noexcept {
+    for (auto index = node.layouts.head; index != no_cache_entry;) {
+        const auto next = layouts_[index].next;
+        layout_count_ -= layouts_[index].value.cost();
+        layouts_.erase(index);
+        index = next;
+    }
+    for (auto index = node.measurements.head; index != no_cache_entry;) {
+        const auto next = measurements_[index].next;
+        measurements_.erase(index);
+        --measurement_count_;
+        index = next;
+    }
+    node.layouts = {};
+    node.measurements = {};
+}
+
+void LayoutCache::retain_layout(NodeCache& node, std::size_t index) noexcept {
+    constexpr std::size_t entries_per_node = 8;
+    const auto [previous, victim] = node.layouts.count == entries_per_node
+        ? oldest(layouts_, node.layouts) : std::pair{no_cache_entry, no_cache_entry};
+    const auto old_count = victim != no_cache_entry
+        ? layouts_[victim].value.cost() : 0;
+    const auto new_count = layouts_[index].value.cost();
+    if (new_count > limits_.maximum_cached_layouts - (layout_count_ - old_count)) {
+        layouts_.erase(index);
+        return;
+    }
+    if (victim != no_cache_entry) {
+        evict(layouts_, node.layouts, previous, victim);
+        layout_count_ -= old_count;
+    }
+    layouts_[index].next = node.layouts.head;
+    node.layouts.head = index;
+    ++node.layouts.count;
+    layout_count_ += new_count;
+}
+
+void LayoutCache::retain_measurement(NodeCache& node, std::size_t index) noexcept {
+    constexpr std::size_t entries_per_node = 16;
+    if (node.measurements.count == entries_per_node) {
+        const auto [previous, victim] = oldest(measurements_, node.measurements);
+        evict(measurements_, node.measurements, previous, victim);
+        --measurement_count_;
+    } else if (measurement_count_ >= limits_.maximum_cached_measurements) {
+        measurements_.erase(index);
+        return;
+    }
+    measurements_[index].next = node.measurements.head;
+    node.measurements.head = index;
+    ++node.measurements.count;
+    ++measurement_count_;
+}
+
+CacheTransaction::~CacheTransaction() {
+    for (const auto& entry : layouts_) {
+        if (entry.index != no_cache_entry) resident_.layouts_.erase(entry.index);
+    }
+    for (const auto& entry : measurements_) {
+        if (entry.index != no_cache_entry) resident_.measurements_.erase(entry.index);
+    }
+    for (auto* node : touched_) {
+        node->pending_layouts = no_cache_entry;
+        node->pending_measurements = no_cache_entry;
+    }
+}
+
+void CacheTransaction::touch(NodeCache& node) {
+    if (node.pending_layouts == no_cache_entry && node.pending_measurements == no_cache_entry) {
+        touched_.push_back(&node);
+    }
+}
+
+const Fragment* CacheTransaction::find(const NodeCache& node, const LayoutCacheKey& key) const {
+    for (auto index = node.pending_layouts; index != no_cache_entry; index = resident_.layouts_[index].next) {
+        if (resident_.layouts_[index].value.key == key) return &resident_.layouts_[index].value.fragment;
+    }
+    for (auto index = node.layouts.head; index != no_cache_entry; index = resident_.layouts_[index].next) {
+        if (resident_.layouts_[index].value.key == key) return &resident_.layouts_[index].value.fragment;
+    }
+    return nullptr;
+}
+
+const Measurement* CacheTransaction::find(const NodeCache& node, const MeasureRequest& request) const {
+    for (auto index = node.pending_measurements; index != no_cache_entry; index = resident_.measurements_[index].next) {
+        if (resident_.measurements_[index].value.request == request) return &resident_.measurements_[index].value.result;
+    }
+    for (auto index = node.measurements.head; index != no_cache_entry; index = resident_.measurements_[index].next) {
+        if (resident_.measurements_[index].value.request == request) return &resident_.measurements_[index].value.result;
+    }
+    return nullptr;
+}
+
+void CacheTransaction::stage(NodeCache& node, const LayoutCacheKey& key, const Fragment& fragment) {
+    constexpr std::size_t maximum_fragment_nodes = 512;
+    const auto count = std::max(std::size_t{1}, fragment.node_count());
+    if (count > maximum_fragment_nodes
+        || count > resident_.limits_.maximum_cached_layouts - layout_count_) return;
+    if (layouts_.empty()) {
+        const auto hint = std::min(reserve_hint_, resident_.limits_.maximum_cached_layouts);
+        resident_.layouts_.reserve(hint);
+        layouts_.reserve(hint);
+    }
+    touch(node);
+    layouts_.push_back({&node});
+    const auto index = resident_.layouts_.insert({key, fragment}, node.pending_layouts);
+    layouts_.back().index = index;
+    node.pending_layouts = index;
+    layout_count_ += count;
+}
+
+void CacheTransaction::stage(NodeCache& node, const MeasureRequest& request,
+                             const Measurement& measurement) {
+    if (measurements_.size() >= resident_.limits_.maximum_cached_measurements) return;
+    if (measurements_.empty()) {
+        const auto hint = std::min(reserve_hint_, resident_.limits_.maximum_cached_measurements);
+        resident_.measurements_.reserve(hint);
+        measurements_.reserve(hint);
+    }
+    touch(node);
+    measurements_.push_back({&node});
+    const auto index = resident_.measurements_.insert({request, measurement}, node.pending_measurements);
+    measurements_.back().index = index;
+    node.pending_measurements = index;
+}
+
+void CacheTransaction::commit() noexcept {
+    // Queries enter a transaction only after a resident/pending miss. There
+    // cannot be an identical resident key to search for again during commit.
+    for (auto& entry : layouts_) {
+        resident_.retain_layout(*entry.owner, entry.index);
+        entry.index = no_cache_entry;
+    }
+    for (auto& entry : measurements_) {
+        resident_.retain_measurement(*entry.owner, entry.index);
+        entry.index = no_cache_entry;
+    }
+}
+
+} // namespace axisly::css::detail
diff --git a/src/css/layout_cache.hpp b/src/css/layout_cache.hpp
new file mode 100644
index 0000000..19481eb
--- /dev/null
+++ b/src/css/layout_cache.hpp
@@ -0,0 +1,142 @@
+#pragma once
+
+#include <axisly/css_tree.hpp>
+#include "layout_fragment.hpp"
+
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <utility>
+#include <vector>
+
+namespace axisly::css::detail {
+
+enum class FragmentDetail { Size, Baseline, Full, LeafSize };
+enum class SizingMode { Inherent, Content };
+
+struct Constraints {
+    std::optional<Unit> known_width, known_height; // border-box
+    bool known_width_is_final{}, known_height_is_final{};
+    // Content-derived dimensions do not establish a definite percentage basis.
+    bool known_width_is_definite{true}, known_height_is_definite{true};
+    AvailableSize available;
+    std::optional<Unit> containing_width, containing_height;
+    bool ignore_preferred_width{}, ignore_preferred_height{};
+    bool ignore_min_max_width{}, ignore_min_max_height{};
+    bool content_based_width{};
+    bool preserve_known_grid_size{};
+    SizingMode sizing_mode{SizingMode::Inherent};
+    FragmentDetail detail{FragmentDetail::Full};
+    bool operator==(const Constraints&) const = default;
+};
+
+// Keep query stages and definiteness explicit, without the optional objects
+// and padding of the algorithm-facing constraint structure in every cache row.
+struct LayoutCacheKey {
+    std::array<Unit, 6> values;
+    std::uint32_t flags;
+    std::size_t depth{};
+    [[nodiscard]] static LayoutCacheKey from(const Constraints& input, std::size_t depth) noexcept;
+    bool operator==(const LayoutCacheKey&) const = default;
+};
+
+struct CacheEntry {
+    LayoutCacheKey key;
+    Fragment fragment;
+    [[nodiscard]] std::size_t cost() const noexcept {
+        const auto nodes = fragment.node_count();
+        return nodes ? nodes : 1;
+    }
+};
+struct MeasurementCacheEntry {
+    MeasureRequest request;
+    Measurement result;
+};
+
+inline constexpr auto no_cache_entry = std::numeric_limits<std::size_t>::max();
+struct CacheList {
+    std::size_t head{no_cache_entry};
+    std::size_t count{};
+};
+struct NodeCache {
+    CacheList layouts, measurements;
+    std::size_t pending_layouts{no_cache_entry};
+    std::size_t pending_measurements{no_cache_entry};
+};
+
+// Slots are shared by the whole tree. Inserting one query does not allocate a
+// hash node and a separate per-node vector. Indices survive arena growth.
+template<class Value>
+class CacheArena {
+public:
+    struct Slot {
+        Value value;
+        std::size_t next{no_cache_entry};
+    };
+    [[nodiscard]] const Slot& operator[](std::size_t index) const noexcept { return slots_[index]; }
+    [[nodiscard]] Slot& operator[](std::size_t index) noexcept { return slots_[index]; }
+    void reserve(std::size_t count) { slots_.reserve(count); }
+    [[nodiscard]] std::size_t insert(Value&& value, std::size_t next) {
+        if (free_ != no_cache_entry) {
+            const auto index = free_;
+            free_ = slots_[index].next;
+            slots_[index] = Slot{std::move(value), next};
+            return index;
+        }
+        slots_.push_back(Slot{std::move(value), next});
+        return slots_.size() - 1;
+    }
+    void erase(std::size_t index) noexcept {
+        slots_[index] = Slot{Value{}, free_};
+        free_ = index;
+    }
+private:
+    std::vector<Slot> slots_;
+    std::size_t free_{no_cache_entry};
+};
+
+class CacheTransaction;
+class LayoutCache {
+    friend class CacheTransaction;
+public:
+    explicit LayoutCache(TreeLimits limits) : limits_(limits) {}
+    void invalidate(NodeCache& node) noexcept;
+private:
+    TreeLimits limits_;
+    CacheArena<CacheEntry> layouts_;
+    CacheArena<MeasurementCacheEntry> measurements_;
+    std::size_t layout_count_{}; // Number of stored node layouts, not queries.
+    std::size_t measurement_count_{};
+    void retain_layout(NodeCache& node, std::size_t index) noexcept;
+    void retain_measurement(NodeCache& node, std::size_t index) noexcept;
+};
+
+// Computation sees its staged queries immediately, while resident entries are
+// changed only by commit(). Unwinding a failed layout clears all pending links.
+class CacheTransaction {
+public:
+    explicit CacheTransaction(LayoutCache& resident) : resident_(resident) {}
+    ~CacheTransaction();
+    CacheTransaction(const CacheTransaction&) = delete;
+    CacheTransaction& operator=(const CacheTransaction&) = delete;
+    void reserve_hint(std::size_t nodes) noexcept { reserve_hint_ = nodes; }
+    [[nodiscard]] const Fragment* find(const NodeCache& node, const LayoutCacheKey& key) const;
+    [[nodiscard]] const Measurement* find(const NodeCache& node, const MeasureRequest& request) const;
+    void stage(NodeCache& node, const LayoutCacheKey& key, const Fragment& fragment);
+    void stage(NodeCache& node, const MeasureRequest& request, const Measurement& measurement);
+    void commit() noexcept;
+private:
+    struct Pending {
+        NodeCache* owner;
+        std::size_t index{no_cache_entry};
+    };
+    LayoutCache& resident_;
+    std::vector<NodeCache*> touched_;
+    std::vector<Pending> layouts_;
+    std::vector<Pending> measurements_;
+    std::size_t layout_count_{};
+    std::size_t reserve_hint_{};
+    void touch(NodeCache& node);
+};
+
+} // namespace axisly::css::detail
diff --git a/src/css/node_store.hpp b/src/css/node_store.hpp
new file mode 100644
index 0000000..14c8cf3
--- /dev/null
+++ b/src/css/node_store.hpp
@@ -0,0 +1,98 @@
+#pragma once
+
+#include <bit>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+namespace axisly::css::detail {
+
+// Node identities are process-wide monotonic integers. A flat directory gives
+// them direct bucket access; separately owned nodes retain stable addresses
+// across growth and deletion. Removed identities are never reused.
+template<class Node>
+class NodeStore {
+    struct Slot {
+        std::uint64_t id{};
+        std::unique_ptr<Node> node;
+    };
+    std::vector<Slot> slots_;
+    std::size_t size_{};
+    unsigned shift_{60};
+
+    [[nodiscard]] static std::size_t bucket(std::uint64_t id, unsigned shift) noexcept {
+        // High product bits also disperse identities interleaved across trees.
+        return static_cast<std::size_t>((id * UINT64_C(11400714819323198485)) >> shift);
+    }
+
+    void grow() {
+        const auto capacity = slots_.empty() ? std::size_t{16} : slots_.size() * 2;
+        if (capacity < slots_.size() || capacity > slots_.max_size()) {
+            throw std::length_error("CSS node directory capacity exceeded");
+        }
+        std::vector<Slot> grown(capacity);
+        const auto mask = capacity - 1;
+        const auto shift = 64u - static_cast<unsigned>(std::countr_zero(capacity));
+        for (auto& slot : slots_) {
+            if (!slot.id) continue;
+            auto index = bucket(slot.id, shift);
+            while (grown[index].id) index = (index + 1) & mask;
+            grown[index] = std::move(slot);
+        }
+        slots_ = std::move(grown);
+        shift_ = shift;
+    }
+
+public:
+    [[nodiscard]] std::size_t size() const noexcept { return size_; }
+
+    [[nodiscard]] const Node* find(std::uint64_t id) const noexcept {
+        if (!id || slots_.empty()) return nullptr;
+        const auto mask = slots_.size() - 1;
+        auto index = bucket(id, shift_);
+        while (slots_[index].id) {
+            if (slots_[index].id == id) return slots_[index].node.get();
+            index = (index + 1) & mask;
+        }
+        return nullptr;
+    }
+
+    [[nodiscard]] Node* find(std::uint64_t id) noexcept {
+        return const_cast<Node*>(std::as_const(*this).find(id));
+    }
+
+    void insert(std::uint64_t id, Node node) {
+        if (!id || find(id)) throw std::logic_error("Duplicate CSS node identity");
+        auto owned = std::make_unique<Node>(std::move(node));
+        if (size_ >= slots_.size() / 2) grow();
+        const auto mask = slots_.size() - 1;
+        auto index = bucket(id, shift_);
+        while (slots_[index].id) index = (index + 1) & mask;
+        slots_[index] = Slot{id, std::move(owned)};
+        ++size_;
+    }
+
+    void erase(std::uint64_t id) noexcept {
+        if (!id || slots_.empty()) return;
+        const auto mask = slots_.size() - 1;
+        auto hole = bucket(id, shift_);
+        while (slots_[hole].id && slots_[hole].id != id) hole = (hole + 1) & mask;
+        if (!slots_[hole].id) return;
+        slots_[hole] = {};
+        --size_;
+        // Back-shift the probe chain so deleted buckets need no tombstones.
+        for (auto next = (hole + 1) & mask; slots_[next].id; next = (next + 1) & mask) {
+            const auto home = bucket(slots_[next].id, shift_);
+            if (((hole - home) & mask) < ((next - home) & mask)) {
+                slots_[hole] = std::move(slots_[next]);
+                slots_[next] = {};
+                hole = next;
+            }
+        }
+    }
+};
+
+} // namespace axisly::css::detail
